# /etc/cordn/cordn.env — Cordn MLS delivery coordinator configuration.
# Generate a persistent hex secret key (e.g. `openssl rand -hex 32`) and set:
#CORDN_SERVER_PRIVATE_KEY=

# Nostr relays (comma-separated).
CORDN_RELAY_URLS=wss://relay.contextvm.org

# Persistent storage (data dir is /var/lib/cordn).
CORDN_STORAGE_BACKEND=sqlite
CORDN_SQLITE_PATH=/var/lib/cordn/cordn.sqlite

# Coordinator self-description (NIP-65 kind 10002 + NIP-01 kind 0).
CORDN_SERVER_NAME=cordn coordinator
#CORDN_DISCOVERY_FALLBACK_RELAYS=wss://purplepag.es,wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol,wss://relay.nostr.net
#CORDN_DISCOVERY_REFRESH_HOURS=24
