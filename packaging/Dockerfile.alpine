# syntax=docker/dockerfile:1
#
# Ultra-minimal Alpine / static-musl container (~10 MB) for cordn-server.
# Consumes prebuilt static musl binaries from ./docker-bins/{amd64,arm64,armv7}/cordn-server
# prepared by the release workflow across linux/amd64, linux/arm64, and linux/arm/v7.

FROM alpine:3.21
ARG TARGETARCH
ARG TARGETVARIANT

RUN apk add --no-cache ca-certificates \
 && addgroup -S -g 10001 cordn \
 && adduser -S -D -H -u 10001 -G cordn cordn \
 && mkdir -p /data && chown cordn:cordn /data

COPY docker-bins/ /tmp/docker-bins/
RUN case "${TARGETARCH}${TARGETVARIANT}" in \
      amd64) cp /tmp/docker-bins/amd64/cordn-server /usr/local/bin/cordn-server ;; \
      arm64) cp /tmp/docker-bins/arm64/cordn-server /usr/local/bin/cordn-server ;; \
      armv7) cp /tmp/docker-bins/armv7/cordn-server /usr/local/bin/cordn-server ;; \
      *) echo "Unsupported platform: ${TARGETARCH}${TARGETVARIANT}" >&2; exit 1 ;; \
    esac \
 && chmod 0755 /usr/local/bin/cordn-server \
 && rm -rf /tmp/docker-bins

USER cordn
ENV CORDN_STORAGE_BACKEND=memory
ENV CORDN_SQLITE_PATH=/data/cordn.sqlite
ENTRYPOINT ["cordn-server"]
